#usda 1.0
(
    doc = """One glTF PBR material twice: as UsdShade shaders with MaterialX
identifiers, and as a reference to the .mtlx document beside this file. Both
reach Lotus as the same Hydra network (docs/design/GLTF_PBR.md section 8.2)."""
    defaultPrim = "GltfStage"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "GltfStage"
{
    def Scope "Looks"
    {
        def Material "Authored"
        {
            token outputs:mtlx:surface.connect = </GltfStage/Looks/Authored/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                float inputs:alpha = 0.6
                float inputs:alpha_cutoff = 0.25
                int inputs:alpha_mode = 1
                color3f inputs:base_color.connect = </GltfStage/Looks/Authored/Half.outputs:out>
                color3f inputs:emissive = (0.8, 0.4, 0.2) (
                    colorSpace = "srgb_texture"
                )
                float inputs:emissive_strength = 2
                float inputs:metallic.connect = </GltfStage/Looks/Authored/Metal.outputs:out>
                float inputs:roughness.connect = </GltfStage/Looks/Authored/Rough.outputs:out>
                token outputs:out
            }

            def Shader "Image"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @./textures/palette.png@ (
                    colorSpace = "srgb_texture"
                )
                color3f outputs:out
            }

            def Shader "Half"
            {
                uniform token info:id = "ND_multiply_color3FA"
                color3f inputs:in1.connect = </GltfStage/Looks/Authored/Image.outputs:out>
                float inputs:in2 = 0.5
                color3f outputs:out
            }

            def Shader "Orm"
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @./textures/rgba.png@
                float3 outputs:out
            }

            def Shader "Rough"
            {
                uniform token info:id = "ND_extract_vector3"
                float3 inputs:in.connect = </GltfStage/Looks/Authored/Orm.outputs:out>
                int inputs:index = 1
                float outputs:out
            }

            def Shader "Metal"
            {
                uniform token info:id = "ND_extract_vector3"
                float3 inputs:in.connect = </GltfStage/Looks/Authored/Orm.outputs:out>
                int inputs:index = 2
                float outputs:out
            }
        }

        def "Referenced" (
            references = @./gltf-stage-v1.mtlx@</MaterialX/Materials/Gltf>
        )
        {
        }
    }
}
