                )
                color3f outputs:out
            }

            def Shader "Multiply"
            {
                uniform token info:id = "ND_multiply_color3FA"
                color3f inputs:in1.connect = </MaterialMtlx/Looks/Untranslated/Image.outputs:out>
                float inputs:in2 = 0.5
                color3f outputs:out
            }
        }
