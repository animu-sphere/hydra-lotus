                float3 inputs:in.connect = </MaterialMtlx/Looks/NormalScale/Bumps.outputs:out>
                float2 inputs:scale = (0.5, 0.5)
                float3 outputs:out
            }
        }

        def Material "Tiled"
        {
            token outputs:mtlx:surface.connect = </MaterialMtlx/Looks/Tiled/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color.connect = </MaterialMtlx/Looks/Tiled/Image.outputs:out>
                token outputs:out
            }

            def Shader "Image"
            {
                uniform token info:id = "ND_tiledimage_color3"
                asset inputs:file = @./textures/palette.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:uvtiling = (1, 1)
                color3f outputs:out
            }
        }

        def Material "Fileless"
        {
            token outputs:mtlx:surface.connect = </MaterialMtlx/Looks/Fileless/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color.connect = </MaterialMtlx/Looks/Fileless/Image.outputs:out>
                token outputs:out
            }

            def Shader "Image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (0.2, 0.6, 0.9)
                color3f outputs:out
            }
        }

        def Material "Untranslated"
        {
            token outputs:mtlx:surface.connect = </MaterialMtlx/Looks/Untranslated/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color.connect = </MaterialMtlx/Looks/Untranslated/Multiply.outputs:out>
                token outputs:out
            }

            def Shader "Image"
            {
