            token outputs:mtlx:surface.connect = </MaterialGltfExtensions/Looks/All/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.9, 0.6, 0.2)
                float inputs:clearcoat = 0.7
                float inputs:clearcoat_roughness = 0.2
                float inputs:ior = 1.8
                float inputs:metallic = 0.3
                float inputs:roughness = 0.4
                color3f inputs:sheen_color = (0.3, 0.5, 0.8)
                float inputs:sheen_roughness = 0.6
                float inputs:specular = 0.8
                color3f inputs:specular_color = (1, 0.8, 0.6)
                float inputs:transmission = 0.4
                token outputs:out
            }
        }

        def Material "CoatMap"
        {
            token outputs:mtlx:surface.connect = </MaterialGltfExtensions/Looks/CoatMap/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.8, 0.2, 0.1)
                float inputs:clearcoat.connect = </MaterialGltfExtensions/Looks/CoatMap/Coat.outputs:out>
                float inputs:clearcoat_roughness.connect = </MaterialGltfExtensions/Looks/CoatMap/CoatRoughness.outputs:out>
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:out
            }

            def Shader "Coat"
            {
                uniform token info:id = "ND_extract_vector4"
                float4 inputs:in.connect = </MaterialGltfExtensions/Looks/CoatMap/Scalars.outputs:out>
                int inputs:index = 0
                float outputs:out
            }

            def Shader "CoatRoughness"
            {
                uniform token info:id = "ND_extract_vector4"
                float4 inputs:in.connect = </MaterialGltfExtensions/Looks/CoatMap/Scalars.outputs:out>
                int inputs:index = 2
                float outputs:out
            }

            def Shader "Scalars"
            {
                uniform token info:id = "ND_image_vector4"
                asset inputs:file = @./textures/rgba.png@
                float4 outputs:out
            }
        }

        def Material "SpecularColorMap"
        {
            token outputs:mtlx:surface.connect = </MaterialGltfExtensions/Looks/SpecularColorMap/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.6, 0.6, 0.6)
                float inputs:ior = 2.4
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                color3f inputs:specular_color.connect = </MaterialGltfExtensions/Looks/SpecularColorMap/Rgb.outputs:out>
                token outputs:out
            }

            def Shader "Image"
            {
                uniform token info:id = "ND_image_color4"
                asset inputs:file = @./textures/palette.png@ (
                    colorSpace = "srgb_texture"
                )
                color4f outputs:out
            }

            def Shader "Rgb"
            {
                uniform token info:id = "ND_convert_color4_color3"
                color4f inputs:in.connect = </MaterialGltfExtensions/Looks/SpecularColorMap/Image.outputs:out>
                color3f outputs:out
            }
        }

        def Material "Thickness"
        {
            token outputs:mtlx:surface.connect = </MaterialGltfExtensions/Looks/Thickness/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.2, 0.6, 0.7)
                float inputs:metallic = 0
                float inputs:roughness = 0
                float inputs:thickness = 1
                float inputs:transmission = 1
                token outputs:out
            }
        }

        def Material "Diagnosed"
        {
            token outputs:mtlx:surface.connect = </MaterialGltfExtensions/Looks/Diagnosed/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                float inputs:anisotropy_strength = 1
                color3f inputs:base_color = (0.8, 0.2, 0.1)
                float inputs:clearcoat = 1
                float inputs:iridescence = 1
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:out
            }
        }
    }

