            def Shader "Rgb"
            {
                uniform token info:id = "ND_convert_color4_color3"
                color4f inputs:in.connect = </MaterialGltf/Looks/Image/Image.outputs:out>
                color3f outputs:out
            }
        }

        def Material "Factor"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Factor/Surface.outputs:out>

