# The unit card every card inherits, facing +Z, without normals.
class Mesh "_Card"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0)]
    uniform token subdivisionScheme = "none"
}

def Xform "MaterialGltf"
{
    def Camera "Camera"
    {
        float2 clippingRange = (1, 100)
        float focalLength = 50
        float horizontalAperture = 32
        float verticalAperture = 32
        double3 xformOp:translate = (0, 0, 6.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "Dome"
    {
        float inputs:intensity = 0.5
    }

    def RectLight "Key"
    {
        float inputs:height = 3
        float inputs:intensity = 4
        float inputs:width = 3
        float xformOp:rotateX = -30
        float xformOp:rotateY = 20
        double3 xformOp:translate = (1.5, 2.5, 4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:rotateX"]
    }

    # Unbound: lit by its displayColor.
    def Mesh "Backdrop"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, -3, -1), (3, -3, -1), (3, 3, -1), (-3, 3, -1)]
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        uniform token subdivisionScheme = "none"
    }

    def Scope "Looks"
    {
        def Material "Defaults"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Defaults/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                token outputs:out
            }
        }

        def Material "Dielectric"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Dielectric/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.8, 0.2, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:out
            }
        }

        def Material "Glossy"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Glossy/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.5, 0.5, 0.5)
                float inputs:metallic = 0
                float inputs:roughness = 0.1
                token outputs:out
            }
        }

        def Material "Metal"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Metal/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.95, 0.64, 0.54)
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:out
            }
        }

        def Material "Mixed"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Mixed/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.9, 0.6, 0.2)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.3
                token outputs:out
            }
        }

        def Material "Image"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Image/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color.connect = </MaterialGltf/Looks/Image/Rgb.outputs:out>
                float inputs:metallic = 0
                float inputs:roughness = 0.6
