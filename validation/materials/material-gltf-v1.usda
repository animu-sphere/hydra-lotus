                float inputs:alpha_cutoff = 0
                int inputs:alpha_mode = 1
                color3f inputs:base_color = (0.2, 0.6, 0.7)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:out
            }
        }

        def Material "MaskAll"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/MaskAll/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                float inputs:alpha_cutoff = 1.5
                int inputs:alpha_mode = 1
                color3f inputs:base_color = (0.2, 0.6, 0.7)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:out
            }
        }

        def Material "Blend"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Blend/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                float inputs:alpha.connect = </MaterialGltf/Looks/Blend/A.outputs:out>
                int inputs:alpha_mode = 2
                color3f inputs:base_color.connect = </MaterialGltf/Looks/Blend/Rgb.outputs:out>
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:out
            }

            def Shader "A"
            {
                uniform token info:id = "ND_extract_color4"
                color4f inputs:in.connect = </MaterialGltf/Looks/Blend/Image.outputs:out>
                int inputs:index = 3
                float outputs:out
            }

            def Shader "Image"
            {
                uniform token info:id = "ND_image_color4"
                asset inputs:file = @./textures/cutout.png@ (
                    colorSpace = "srgb_texture"
                )
                color4f outputs:out
            }

            def Shader "Rgb"
            {
                uniform token info:id = "ND_convert_color4_color3"
                color4f inputs:in.connect = </MaterialGltf/Looks/Blend/Image.outputs:out>
                color3f outputs:out
            }
        }

        def Material "Clearcoat"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Clearcoat/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.8, 0.2, 0.1)
                float inputs:clearcoat = 1
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:out
            }
        }

        def Material "Transmission"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Transmission/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.8, 0.2, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                float inputs:transmission = 1
                token outputs:out
            }
        }

        def Material "Unlit"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Unlit/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0, 0, 0)
                color3f inputs:emissive = (0.2, 0.6, 0.7)
                float inputs:metallic = 0
                float inputs:roughness = 1
                float inputs:specular = 0
                token outputs:out
            }
        }

        def Material "Ior"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/Ior/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.8, 0.2, 0.1)
                float inputs:ior = 1.8
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:out
            }
        }

        def Material "VertexColor"
        {
            token outputs:mtlx:surface.connect = </MaterialGltf/Looks/VertexColor/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color.connect = </MaterialGltf/Looks/VertexColor/Tint.outputs:out>
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:out
            }

            def Shader "Color"
            {
                uniform token info:id = "ND_geompropvalue_color3"
                string inputs:geomprop = "displayColor"
                color3f outputs:out
            }

            def Shader "Tint"
            {
                uniform token info:id = "ND_multiply_color3"
                color3f inputs:in1.connect = </MaterialGltf/Looks/VertexColor/Color.outputs:out>
                color3f inputs:in2 = (1, 0.5, 0.25)
                color3f outputs:out
            }
        }
    }

