#usda 1.0
(
    doc = """One material twice: as UsdShade shaders with MaterialX identifiers,
and as a reference to the .mtlx document beside this file. Both reach Lotus
as the same Hydra network (docs/design/MATERIALX_TRANSLATION.md section 3)."""
    defaultPrim = "GraphStage"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "GraphStage"
{
    def Scope "Looks"
    {
        def Material "Authored"
        {
            token outputs:mtlx:surface.connect = </GraphStage/Looks/Authored/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color.connect = </GraphStage/Looks/Authored/Half.outputs:out>
                float inputs:emission = 1
                color3f inputs:emission_color = (0.8, 0.4, 0.2) (
                    colorSpace = "srgb_texture"
                )
                float inputs:specular_roughness.connect = </GraphStage/Looks/Authored/Rough.outputs:out>
                token outputs:out
            }

            def Shader "Coords"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "Place"
            {
                uniform token info:id = "ND_place2d_vector2"
                float inputs:rotate = 30
                float2 inputs:scale = (2, 1)
                float2 inputs:texcoord.connect = </GraphStage/Looks/Authored/Coords.outputs:out>
                float2 outputs:out
            }

            def Shader "Image"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @./textures/palette.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </GraphStage/Looks/Authored/Place.outputs:out>
                color3f outputs:out
            }

            def Shader "Half"
            {
                uniform token info:id = "ND_multiply_color3FA"
                color3f inputs:in1.connect = </GraphStage/Looks/Authored/Image.outputs:out>
                float inputs:in2 = 0.5
                color3f outputs:out
            }

            def Shader "Orm"
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @./textures/rgba.png@
                float3 outputs:out
            }

            def Shader "Rough"
            {
                uniform token info:id = "ND_extract_vector3"
                float3 inputs:in.connect = </GraphStage/Looks/Authored/Orm.outputs:out>
                int inputs:index = 1
                float outputs:out
            }
        }

        def "Referenced" (
            references = @./graph-stage-v1.mtlx@</MaterialX/Materials/Graph>
        )
        {
        }
    }
}
