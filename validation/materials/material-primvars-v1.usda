                interpolation = "faceVarying"
            )
            int[] primvars:tint:indices = [3, 2, 1, 0]
            float3 xformOp:scale = (0.7, 0.7, 0.7)
            double3 xformOp:translate = (0, 0.8, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Mesh "Uniform" (
