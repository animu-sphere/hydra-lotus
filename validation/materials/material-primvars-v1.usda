#usda 1.0
(
    defaultPrim = "MaterialPrimvars"
    metersPerUnit = 1
    upAxis = "Y"
)

# Generated by scripts/material_fixtures.py; edit it there. Mirrored by
# adapters/common/material_fixtures.cpp (SetMaterialPrimvars).

# The unit card every card inherits, facing +Z, without normals.
class Mesh "_Card"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0)]
    uniform token subdivisionScheme = "none"
}

# A card of two quads, left and right.
class Mesh "_Split"
{
    int[] faceVertexCounts = [4, 4]
    int[] faceVertexIndices = [0, 1, 4, 5, 1, 2, 3, 4]
    point3f[] points = [(-0.5, -0.5, 0), (0, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (0, 0.5, 0), (-0.5, 0.5, 0)]
    uniform token subdivisionScheme = "none"
}

def Xform "MaterialPrimvars"
{
    def Camera "Camera"
    {
        float2 clippingRange = (1, 100)
        float focalLength = 50
        float horizontalAperture = 32
        float verticalAperture = 32
        double3 xformOp:translate = (0, 0, 6.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "Dome"
    {
        float inputs:intensity = 0.5
    }

    def RectLight "Key"
    {
        float inputs:height = 3
        float inputs:intensity = 4
        float inputs:width = 3
        float xformOp:rotateX = -30
        float xformOp:rotateY = 20
        double3 xformOp:translate = (1.5, 2.5, 4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:rotateX"]
    }

    # Unbound: lit by its displayColor.
    def Mesh "Backdrop"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, -3, -1), (3, -3, -1), (3, 3, -1), (-3, 3, -1)]
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        uniform token subdivisionScheme = "none"
    }

    def Scope "Looks"
    {
        def Material "Tint"
        {
            token outputs:surface.connect = </MaterialPrimvars/Looks/Tint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </MaterialPrimvars/Looks/Tint/Colors.outputs:result>
                float inputs:roughness = 0.4
                token outputs:surface
            }

            def Shader "Colors"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                string inputs:varname = "tint"
                float3 outputs:result
            }
        }

        def Material "Display"
        {
            token outputs:surface.connect = </MaterialPrimvars/Looks/Display/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </MaterialPrimvars/Looks/Display/Colors.outputs:result>
                float inputs:roughness = 0.4
                token outputs:surface
            }

            def Shader "Colors"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                string inputs:varname = "displayColor"
                float3 outputs:result
            }
        }

        def Material "Absent"
        {
            token outputs:surface.connect = </MaterialPrimvars/Looks/Absent/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </MaterialPrimvars/Looks/Absent/Colors.outputs:result>
                float inputs:roughness = 0.4
                token outputs:surface
            }

            def Shader "Colors"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (1.5, 0.25, -0.5)
                string inputs:varname = "absent"
                float3 outputs:result
            }
        }

        def Material "Unnamed"
        {
            token outputs:surface.connect = </MaterialPrimvars/Looks/Unnamed/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </MaterialPrimvars/Looks/Unnamed/Colors.outputs:result>
                float inputs:roughness = 0.4
                token outputs:surface
            }

            def Shader "Colors"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (0.25, 0.5, 0.75)
                string inputs:varname = "tint"
                float3 outputs:result
            }
        }

        def Material "Glowing"
        {
            token outputs:surface.connect = </MaterialPrimvars/Looks/Glowing/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
                color3f inputs:emissiveColor.connect = </MaterialPrimvars/Looks/Glowing/Colors.outputs:result>
                token outputs:surface
            }

            def Shader "Colors"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                string inputs:varname = "tint"
                float3 outputs:result
            }
        }
    }

    def Scope "Objects"
    {
        def Mesh "Vertex" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            prepend inherits = </_Card>
        )
        {
            rel material:binding = </MaterialPrimvars/Looks/Tint>
