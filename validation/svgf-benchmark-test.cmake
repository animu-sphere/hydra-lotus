cmake_minimum_required(VERSION 3.24)
# The SVGF comparison's procedure and report at a small size. Quality and
# timing are observed, never a pass threshold.
if(NOT DEFINED EXECUTABLE OR NOT DEFINED TEST_ROOT OR NOT DEFINED INTEGRATOR)
  message(FATAL_ERROR "EXECUTABLE, TEST_ROOT and INTEGRATOR are required")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(report "${TEST_ROOT}/svgf.json")
foreach(rejected "--svgf-iterations;9" "--svgf-sequences;1" "--svgf-unknown;1")
  execute_process(COMMAND "${EXECUTABLE}" --benchmark-svgf "${TEST_ROOT}/rejected.json" ${rejected}
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 60)
  if(NOT result STREQUAL "2" OR EXISTS "${TEST_ROOT}/rejected.json")
    message(FATAL_ERROR "Invalid option ${rejected} was accepted (${result})")
  endif()
endforeach()
execute_process(COMMAND "${EXECUTABLE}" --benchmark-svgf "${report}"
  --benchmark-integrator "${INTEGRATOR}" --benchmark-label "CTest quoted \"label\""
  --benchmark-size 32 --benchmark-frames 4 --svgf-sequences 2 --svgf-reference-samples 32
  --svgf-iterations 3 --svgf-history-cap 8
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 300)
if(NOT result STREQUAL "0" AND NOT result STREQUAL "77")
  message(FATAL_ERROR "SVGF benchmark failed (${result}):\n${output}\n${error}")
endif()
file(READ "${report}" json)
string(JSON schema GET "${json}" schema)
string(JSON status GET "${json}" status)
string(JSON label GET "${json}" build label)
string(JSON integrator GET "${json}" procedure integrator)
string(JSON iterations GET "${json}" procedure filter_iterations)
string(JSON cap GET "${json}" procedure history_cap)
string(JSON count LENGTH "${json}" scenes)
if(NOT schema STREQUAL "lotus-svgf-benchmark-v1" OR NOT label STREQUAL "CTest quoted \"label\"" OR
   NOT integrator STREQUAL INTEGRATOR OR NOT iterations EQUAL 3 OR NOT cap EQUAL 8)
  message(FATAL_ERROR "Wrong schema, build or procedure")
endif()
if(result STREQUAL "77")
  if(NOT status STREQUAL "skip" OR NOT count EQUAL 0)
    message(FATAL_ERROR "Unavailable capabilities must have explained SKIP and no measurements")
  endif()
  message(STATUS "SKIP: ${output}")
  return()
endif()
if(NOT status STREQUAL "pass" OR NOT count EQUAL 2)
  message(FATAL_ERROR "Successful benchmark requires both scenes")
endif()
string(JSON image_directory GET "${json}" image_directory)
set(ids svgf-room-static-v1 svgf-room-moving-camera-block-v1)
foreach(s RANGE 0 1)
  list(GET ids ${s} expected_id)
  string(JSON id GET "${json}" scenes ${s} id)
  string(JSON deterministic GET "${json}" scenes ${s} deterministic)
  string(JSON poses LENGTH "${json}" scenes ${s} reference_split_rmse)
  if(NOT id STREQUAL expected_id OR NOT deterministic OR
     (s EQUAL 0 AND NOT poses EQUAL 1) OR (s EQUAL 1 AND NOT poses EQUAL 4))
    message(FATAL_ERROR "Wrong workload, reference poses or nondeterministic output in ${expected_id}")
  endif()
  if(NOT EXISTS "${TEST_ROOT}/${image_directory}/${id}-reference.pfm")
    message(FATAL_ERROR "Missing reference image for ${id}")
  endif()
  foreach(output raw temporal filtered)
    string(JSON mse GET "${json}" scenes ${s} outputs ${output} mse)
    string(JSON frames LENGTH "${json}" scenes ${s} outputs ${output} mse_by_frame)
    string(JSON deltas LENGTH "${json}" scenes ${s} outputs ${output} frame_delta_mse_by_frame)
    string(JSON buckets LENGTH "${json}" scenes ${s} outputs ${output} history_buckets)
    string(JSON excess TYPE "${json}" scenes ${s} outputs ${output} last_frame_ensemble excess_mse)
    if(NOT mse GREATER 0 OR NOT frames EQUAL 4 OR NOT deltas EQUAL 3 OR NOT buckets EQUAL 4 OR
       NOT excess STREQUAL "NUMBER")
      message(FATAL_ERROR "Incomplete ${output} statistics in ${id}")
    endif()
    if(NOT EXISTS "${TEST_ROOT}/${image_directory}/${id}-${output}.pfm")
      message(FATAL_ERROR "Missing ${output} image for ${id}")
    endif()
  endforeach()
  string(JSON filter_bytes GET "${json}" scenes ${s} memory filter_bytes)
  if(NOT filter_bytes EQUAL 32768)
    message(FATAL_ERROR "Filter memory is not 32 bytes per pixel")
  endif()
endforeach()
