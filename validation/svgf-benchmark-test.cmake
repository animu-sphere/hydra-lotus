cmake_minimum_required(VERSION 3.24)
# The SVGF comparison's procedure and report at a small size. Quality and
# timing are observed, never a pass threshold.
if(NOT DEFINED EXECUTABLE OR NOT DEFINED TEST_ROOT OR NOT DEFINED INTEGRATOR)
  message(FATAL_ERROR "EXECUTABLE, TEST_ROOT and INTEGRATOR are required")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(report "${TEST_ROOT}/svgf.json")
foreach(rejected "--svgf-iterations;9" "--svgf-sequences;1" "--svgf-hold;2" "--svgf-unknown;1")
  execute_process(COMMAND "${EXECUTABLE}" --benchmark-svgf "${TEST_ROOT}/rejected.json" ${rejected}
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 60)
  if(NOT result STREQUAL "2" OR EXISTS "${TEST_ROOT}/rejected.json")
    message(FATAL_ERROR "Invalid option ${rejected} was accepted (${result})")
  endif()
endforeach()
execute_process(COMMAND "${EXECUTABLE}" --benchmark-svgf "${report}"
  --benchmark-integrator "${INTEGRATOR}" --benchmark-label "CTest quoted \"label\""
  --benchmark-size 32 --benchmark-frames 4 --svgf-sequences 2 --svgf-reference-samples 32
  --svgf-iterations 3 --svgf-history-cap 8 --svgf-hold 6
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 300)
if(NOT result STREQUAL "0" AND NOT result STREQUAL "77")
  message(FATAL_ERROR "SVGF benchmark failed (${result}):\n${output}\n${error}")
endif()
file(READ "${report}" json)
string(JSON schema GET "${json}" schema)
string(JSON status GET "${json}" status)
string(JSON label GET "${json}" build label)
string(JSON integrator GET "${json}" procedure integrator)
string(JSON iterations GET "${json}" procedure filter_iterations)
string(JSON cap GET "${json}" procedure history_cap)
string(JSON hold GET "${json}" procedure settling_hold_frames)
string(JSON count LENGTH "${json}" scenes)
if(NOT schema STREQUAL "lotus-svgf-benchmark-v3" OR NOT label STREQUAL "CTest quoted \"label\"" OR
   NOT integrator STREQUAL INTEGRATOR OR NOT iterations EQUAL 3 OR NOT cap EQUAL 8 OR NOT hold EQUAL 6)
  message(FATAL_ERROR "Wrong schema, build or procedure")
endif()
if(result STREQUAL "77")
  if(NOT status STREQUAL "skip" OR NOT count EQUAL 0)
    message(FATAL_ERROR "Unavailable capabilities must have explained SKIP and no measurements")
  endif()
  message(STATUS "SKIP: ${output}")
  return()
endif()
if(NOT status STREQUAL "pass" OR NOT count EQUAL 5)
  message(FATAL_ERROR "Successful benchmark requires every fixture")
endif()
string(JSON image_directory GET "${json}" image_directory)
# The contract's fixed fixture set, in report order, and each one's lag region.
set(ids svgf-room-static-v1 svgf-room-moving-camera-block-v1 occluder-shadow-sweep-v1
  glossy-floor-camera-pan-v1 deforming-sheet-v1)
set(regions none none swept albedo albedo)
foreach(s RANGE 0 4)
  list(GET ids ${s} expected_id)
  list(GET regions ${s} expected_region)
  string(JSON id GET "${json}" scenes ${s} id)
  string(JSON deterministic GET "${json}" scenes ${s} deterministic)
  string(JSON poses LENGTH "${json}" scenes ${s} reference_split_rmse)
  string(JSON region GET "${json}" scenes ${s} lag_region kind)
  string(JSON region_pixels GET "${json}" scenes ${s} lag_region mean_pixels)
  string(JSON resets TYPE "${json}" scenes ${s} history_resets_after_cut)
  if(NOT id STREQUAL expected_id OR NOT deterministic OR
     (s EQUAL 0 AND NOT poses EQUAL 1) OR (s GREATER 0 AND NOT poses EQUAL 4) OR
     NOT region STREQUAL expected_region OR NOT resets STREQUAL "OBJECT")
    message(FATAL_ERROR "Wrong workload, reference poses, lag region or nondeterministic output in ${expected_id}")
  endif()
  if((region STREQUAL "none") EQUAL (region_pixels GREATER 0))
    message(FATAL_ERROR "Lag region of ${id} is empty or unexpected (${region_pixels} pixels)")
  endif()
  if(NOT EXISTS "${TEST_ROOT}/${image_directory}/${id}-reference.pfm")
    message(FATAL_ERROR "Missing reference image for ${id}")
  endif()
  foreach(output raw temporal filtered progressive)
    string(JSON mse GET "${json}" scenes ${s} outputs ${output} mse)
    string(JSON lag TYPE "${json}" scenes ${s} outputs ${output} lag_region_mse)
    string(JSON lag_frames LENGTH "${json}" scenes ${s} outputs ${output} lag_region_mse_by_frame)
    if(NOT lag_frames EQUAL 4 OR (region STREQUAL "none" AND NOT lag STREQUAL "NULL") OR
       (NOT region STREQUAL "none" AND NOT lag STREQUAL "NUMBER"))
      message(FATAL_ERROR "Incomplete ${output} lag statistics in ${id}")
    endif()
    string(JSON frames LENGTH "${json}" scenes ${s} outputs ${output} mse_by_frame)
    string(JSON deltas LENGTH "${json}" scenes ${s} outputs ${output} frame_delta_mse_by_frame)
    string(JSON buckets LENGTH "${json}" scenes ${s} outputs ${output} history_buckets)
    string(JSON excess TYPE "${json}" scenes ${s} outputs ${output} last_frame_ensemble excess_mse)
    if(NOT mse GREATER 0 OR NOT frames EQUAL 4 OR NOT deltas EQUAL 3 OR NOT buckets EQUAL 4 OR
       NOT excess STREQUAL "NUMBER")
      message(FATAL_ERROR "Incomplete ${output} statistics in ${id}")
    endif()
    if(NOT EXISTS "${TEST_ROOT}/${image_directory}/${id}-${output}.pfm")
      message(FATAL_ERROR "Missing ${output} image for ${id}")
    endif()
  endforeach()
  # Settling: Balanced settles in the hold and converges to the Reference
  # frame bit for bit; a still workload has no moving view to compare with.
  string(JSON settled GET "${json}" scenes ${s} settling settling_frames_per_sequence)
  string(JSON equal GET "${json}" scenes ${s} settling converged_equals_reference)
  string(JSON moving_delta TYPE "${json}" scenes ${s} settling moving_frame_delta_mse)
  string(JSON no_pop TYPE "${json}" scenes ${s} settling no_pop)
  if(NOT settled GREATER_EQUAL 6 OR NOT equal OR (s EQUAL 0) EQUAL (moving_delta STREQUAL "NUMBER") OR
     (s EQUAL 0) EQUAL (no_pop STREQUAL "BOOLEAN"))
    message(FATAL_ERROR "Settling did not settle, converge to Reference or compare with the moving view in ${id}")
  endif()
  foreach(output balanced interactive reference)
    string(JSON frames LENGTH "${json}" scenes ${s} settling outputs ${output} mse_by_frame)
    string(JSON deltas LENGTH "${json}" scenes ${s} settling outputs ${output} frame_delta_mse_by_frame)
    if(NOT frames EQUAL 10 OR NOT deltas EQUAL 10)
      message(FATAL_ERROR "Incomplete ${output} settling statistics in ${id}")
    endif()
  endforeach()
  string(JSON filter_bytes GET "${json}" scenes ${s} memory filter_bytes)
  if(NOT filter_bytes EQUAL 49152)
    message(FATAL_ERROR "Filter memory is not 48 bytes per pixel")
  endif()
endforeach()
