cmake_minimum_required(VERSION 3.24)
# Script mode does not inherit the parent project's policies. In particular,
# CMP0007 must retain the empty value in the rejected "--restir-candidates|"
# case on CMake 3.x as well as CMake 4.x.
# Small report/measurement regression. Timing is observed, never a pass threshold.
if(NOT DEFINED EXECUTABLE OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "EXECUTABLE and TEST_ROOT are required")
endif()
if(NOT DEFINED INTEGRATOR)
  set(INTEGRATOR reference)
endif()
if(NOT DEFINED PROPOSAL)
  set(PROPOSAL power-alias)
endif()
if(NOT DEFINED WORKLOAD)
  set(WORKLOAD distant)
endif()
if(NOT DEFINED BOUNCES)
  set(BOUNCES 1)
endif()
if(NOT DEFINED REFERENCE_SEED)
  set(REFERENCE_SEED 16777216)
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
if(NO_DRIVER)
  set(manifest "${TEST_ROOT}/unavailable-manifest.json")
  if(EXISTS "${manifest}")
    message(FATAL_ERROR "Missing-driver manifest must not exist")
  endif()
  set(ENV{VK_DRIVER_FILES} "${manifest}")
  set(ENV{VK_ICD_FILENAMES} "${manifest}")
endif()
set(report "${TEST_ROOT}/restir.json")
execute_process(COMMAND "${EXECUTABLE}" --benchmark-restir "${report}"
  --benchmark-integrator "${INTEGRATOR}" --benchmark-label "CTest quoted \"label\""
  --benchmark-size 16 --benchmark-frames 4 --benchmark-warmup 1
  --restir-sequences 2 --restir-reference-samples 32 --restir-lights 32
  --restir-candidates 1,8 --restir-history-cap 8
  --restir-proposal "${PROPOSAL}" --restir-seed 262165 --restir-workload "${WORKLOAD}"
  --restir-bounces "${BOUNCES}" --restir-reference-seed "${REFERENCE_SEED}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
if(NOT result STREQUAL "0" AND NOT result STREQUAL "77")
  message(FATAL_ERROR "ReSTIR benchmark failed (${result}):\n${output}\n${error}")
endif()
file(READ "${report}" json)
string(JSON schema GET "${json}" schema)
string(JSON status GET "${json}" status)
string(JSON label GET "${json}" build label)
string(JSON integrator GET "${json}" procedure integrator)
string(JSON reference_integrator GET "${json}" procedure reference_integrator)
string(JSON proposal GET "${json}" procedure candidate_proposal)
string(JSON seed GET "${json}" procedure sample_index)
string(JSON reference_seed GET "${json}" procedure reference_seed)
string(JSON bounces GET "${json}" procedure max_bounces)
string(JSON workload GET "${json}" procedure workload_suite)
string(JSON radiance GET "${json}" procedure radiance_reuse)
string(JSON count LENGTH "${json}" scenes)
if(NOT schema STREQUAL "lotus-restir-benchmark-v1" OR
   NOT label STREQUAL "CTest quoted \"label\"" OR NOT integrator STREQUAL INTEGRATOR OR
   NOT reference_integrator STREQUAL "reference" OR NOT proposal STREQUAL PROPOSAL OR
   NOT seed EQUAL 262165 OR NOT reference_seed EQUAL REFERENCE_SEED OR
   NOT bounces EQUAL BOUNCES OR NOT workload STREQUAL WORKLOAD OR radiance)
  message(FATAL_ERROR "Wrong schema/build/estimator procedure")
endif()
if(result STREQUAL "77")
  string(JSON detail GET "${json}" detail)
  string(JSON device TYPE "${json}" device)
  if(NOT status STREQUAL "skip" OR NOT count EQUAL 0 OR detail STREQUAL "" OR NOT device STREQUAL "NULL")
    message(FATAL_ERROR "Unavailable capabilities must have explained SKIP and no measurements")
  endif()
else()
  if(NOT status STREQUAL "pass" OR NOT count EQUAL 2)
    message(FATAL_ERROR "Successful benchmark requires both scenes")
  endif()
  string(JSON image_directory GET "${json}" image_directory)
  set(ids many-distant-plane-v1 many-distant-moving-shadow-v1)
  if(WORKLOAD STREQUAL "mixed-boundaries")
    set(ids mixed-area-environment-boundaries-v1 mixed-area-environment-moving-boundaries-v1)
  elseif(WORKLOAD STREQUAL "glossy-disocclusion" OR WORKLOAD STREQUAL "glossy-spheres" OR
         WORKLOAD STREQUAL "interreflection")
    set(ids glossy-area-environment-static-v1 glossy-area-environment-camera-disocclusion-v1)
    if(WORKLOAD STREQUAL "glossy-spheres")
      set(ids glossy-sphere-environment-static-v1 glossy-sphere-environment-camera-disocclusion-v1)
    elseif(WORKLOAD STREQUAL "interreflection")
      set(ids interreflection-room-static-v1 interreflection-room-moving-block-v1)
    endif()
    # The static control and moving sequence begin at the same pose with
    # identical geometry/lights and disjoint reference halves using the same
    # seeds. Their independent NEE/MIS images must therefore agree exactly.
    list(GET ids 0 static_id)
    list(GET ids 1 moving_id)
    file(SHA256 "${TEST_ROOT}/${image_directory}/${static_id}-mis-reference-0.pfm" static_reference)
    file(SHA256 "${TEST_ROOT}/${image_directory}/${moving_id}-mis-reference-0.pfm" moving_reference)
    if(NOT static_reference STREQUAL moving_reference)
      message(FATAL_ERROR "Static control differs from the first moving pose")
    endif()
  endif()
  set(modes mis initial temporal spatial spatiotemporal initial temporal spatial spatiotemporal)
  foreach(s RANGE 0 1)
    list(GET ids ${s} expected_id)
    string(JSON id GET "${json}" scenes ${s} id)
    string(JSON cases LENGTH "${json}" scenes ${s} cases)
    string(JSON reference_count LENGTH "${json}" scenes ${s} reference_split_rmse)
    string(JSON reference_kind GET "${json}" scenes ${s} error_reference)
    string(JSON integral TYPE "${json}" scenes ${s} independent_integral_rgb)
    if(s EQUAL 0 AND WORKLOAD STREQUAL "distant")
      if(NOT reference_kind STREQUAL "independent-lambert-integral" OR NOT integral STREQUAL "ARRAY")
        message(FATAL_ERROR "Missing exact Lambert reference")
      endif()
    elseif(NOT reference_kind STREQUAL "finite-spp-nee-mis" OR NOT integral STREQUAL "NULL")
      message(FATAL_ERROR "Finite NEE/MIS reference must not claim an exact integral")
    endif()
    if(NOT id STREQUAL expected_id OR NOT cases EQUAL 9 OR
       (s EQUAL 0 AND NOT reference_count EQUAL 1) OR (s EQUAL 1 AND NOT reference_count EQUAL 4))
      message(FATAL_ERROR "Wrong workloads, candidates or independent reference population")
    endif()
    foreach(c RANGE 0 8)
      list(GET modes ${c} expected_mode)
      string(JSON mode GET "${json}" scenes ${s} cases ${c} mode)
      string(JSON candidates GET "${json}" scenes ${s} cases ${c} candidates)
      if(c EQUAL 0)
        set(expected_candidates 0)
        set(bytes_per_pixel 0)
      elseif(c LESS 5)
        set(expected_candidates 1)
      else()
        set(expected_candidates 8)
      endif()
      if(mode STREQUAL "initial")
        set(bytes_per_pixel 96)
      elseif(mode STREQUAL "temporal")
        set(bytes_per_pixel 864)
      elseif(mode STREQUAL "spatial" OR mode STREQUAL "spatiotemporal")
        set(bytes_per_pixel 1280)
      endif()
      math(EXPR expected_bytes "256 * ${bytes_per_pixel}")
      string(JSON memory GET "${json}" scenes ${s} cases ${c} memory reservoir_device_and_host_bytes)
      string(JSON vram TYPE "${json}" scenes ${s} cases ${c} memory total_vram_bytes)
      string(JSON reuse GET "${json}" scenes ${s} cases ${c} history_receiver_pixels)
      string(JSON final_image GET "${json}" scenes ${s} cases ${c} last_image)
      string(JSON ensemble_image GET "${json}" scenes ${s} cases ${c} ensemble_image)
      string(JSON convergence TYPE "${json}" scenes ${s} cases ${c} convergence)
      string(JSON rmse GET "${json}" scenes ${s} cases ${c} ensemble_rmse)
      string(JSON regions LENGTH "${json}" scenes ${s} cases ${c} regions)
      if(NOT WORKLOAD STREQUAL "distant")
        set(expected_regions 1)
        if(WORKLOAD STREQUAL "glossy-disocclusion" OR WORKLOAD STREQUAL "glossy-spheres")
          set(expected_regions 2)
          string(JSON glossy_id GET "${json}" scenes ${s} cases ${c} regions 1 id)
          string(JSON glossy_pixels GET "${json}" scenes ${s} cases ${c} regions 1 pixels)
          string(JSON glossy_rmse GET "${json}" scenes ${s} cases ${c} regions 1 ensemble_rmse)
          if(NOT glossy_id STREQUAL "right-glossy-band-v1" OR NOT glossy_pixels EQUAL 64 OR glossy_rmse LESS 0)
            message(FATAL_ERROR "Missing glossy error measurements")
          endif()
        endif()
        if(WORKLOAD STREQUAL "glossy-spheres")
          set(expected_regions 3)
          string(JSON dielectric_id GET "${json}" scenes ${s} cases ${c} regions 2 id)
          string(JSON dielectric_pixels GET "${json}" scenes ${s} cases ${c} regions 2 pixels)
          string(JSON dielectric_rmse GET "${json}" scenes ${s} cases ${c} regions 2 ensemble_rmse)
          if(NOT dielectric_id STREQUAL "left-dielectric-band-v1" OR
             NOT dielectric_pixels EQUAL 64 OR dielectric_rmse LESS 0)
            message(FATAL_ERROR "Missing dielectric error measurements")
          endif()
        endif()
        if(WORKLOAD STREQUAL "interreflection")
          set(expected_regions 2)
          string(JSON wall_id GET "${json}" scenes ${s} cases ${c} regions 1 id)
          string(JSON wall_pixels GET "${json}" scenes ${s} cases ${c} regions 1 pixels)
          string(JSON wall_rmse GET "${json}" scenes ${s} cases ${c} regions 1 ensemble_rmse)
          if(NOT wall_id STREQUAL "left-red-wall-band-v1" OR NOT wall_pixels EQUAL 64 OR wall_rmse LESS 0)
            message(FATAL_ERROR "Missing red-wall error measurements")
          endif()
        endif()
        string(JSON region GET "${json}" scenes ${s} cases ${c} regions 0 id)
        string(JSON pixels GET "${json}" scenes ${s} cases ${c} regions 0 pixels)
        string(JSON region_rmse GET "${json}" scenes ${s} cases ${c} regions 0 ensemble_rmse)
        if(NOT regions EQUAL expected_regions OR NOT region STREQUAL "center-boundary-band-v1" OR
           NOT pixels EQUAL 64 OR region_rmse LESS 0)
          message(FATAL_ERROR "Missing boundary error measurements")
        endif()
      elseif(NOT regions EQUAL 0)
        message(FATAL_ERROR "Unexpected boundary region")
      endif()
      if(NOT mode STREQUAL expected_mode OR NOT candidates EQUAL expected_candidates OR
         NOT memory EQUAL expected_bytes OR NOT vram STREQUAL "NULL" OR rmse LESS 0 OR
         NOT EXISTS "${TEST_ROOT}/${image_directory}/${final_image}" OR
         NOT EXISTS "${TEST_ROOT}/${image_directory}/${ensemble_image}")
        message(FATAL_ERROR "Wrong mode/independent memory accounting or images")
      endif()
      if((mode STREQUAL "temporal" OR mode STREQUAL "spatiotemporal") AND NOT reuse GREATER 0)
        message(FATAL_ERROR "Temporal benchmark never accepted history")
      endif()
      if(s EQUAL 0)
        string(JSON checkpoints LENGTH "${json}" scenes ${s} cases ${c} convergence)
        string(JSON samples GET "${json}" scenes ${s} cases ${c} convergence 2 samples)
        if(NOT convergence STREQUAL "ARRAY" OR NOT checkpoints EQUAL 3 OR NOT samples EQUAL 4)
          message(FATAL_ERROR "Missing static convergence curve")
        endif()
        foreach(checkpoint RANGE 0 2)
          string(JSON population LENGTH "${json}" scenes ${s} cases ${c} convergence ${checkpoint} rmse_raw)
          if(NOT population EQUAL 2)
            message(FATAL_ERROR "Missing independent convergence population")
          endif()
          string(JSON gpu_population TYPE "${json}" scenes ${s} cases ${c} convergence ${checkpoint} cumulative_gpu_ms_raw)
          if(NOT gpu_population STREQUAL "NULL")
            string(JSON population LENGTH "${json}" scenes ${s} cases ${c} convergence ${checkpoint} cumulative_gpu_ms_raw)
            if(NOT population EQUAL 2)
              message(FATAL_ERROR "Missing cumulative GPU population")
            endif()
          endif()
        endforeach()
        if(WORKLOAD STREQUAL "distant")
          foreach(channel RANGE 0 2)
            string(JSON bias GET "${json}" scenes ${s} cases ${c} signed_mean_error_rgb ${channel})
            # Independent Lambert integral gate; broad for this small smoke run.
            if(bias LESS -0.15 OR bias GREATER 0.15)
              message(FATAL_ERROR "Static ensemble fails independent integral: ${mode} ${bias}")
            endif()
          endforeach()
        endif()
        string(JSON ensemble_type TYPE "${json}" scenes ${s} cases ${c} sequence_ensemble)
        string(JSON ensemble_sequences GET "${json}" scenes ${s} cases ${c} sequence_ensemble sequences)
        string(JSON ensemble_frames GET "${json}" scenes ${s} cases ${c} sequence_ensemble frames)
        string(JSON reference_noise GET "${json}" scenes ${s} cases ${c} sequence_ensemble reference_noise_mse)
        if(NOT ensemble_type STREQUAL "OBJECT" OR NOT ensemble_sequences EQUAL 2 OR NOT ensemble_frames EQUAL 4 OR
           (WORKLOAD STREQUAL "distant" AND NOT reference_noise EQUAL 0) OR
           (NOT WORKLOAD STREQUAL "distant" AND NOT reference_noise GREATER 0))
          message(FATAL_ERROR "Missing static sequence ensemble decomposition")
        endif()
        foreach(metric frame_variance sequence_mean_variance grand_mean_mse grand_mean_noise_mse)
          string(JSON value GET "${json}" scenes ${s} cases ${c} sequence_ensemble ${metric})
          if(value LESS 0)
            message(FATAL_ERROR "Negative sequence ensemble ${metric}")
          endif()
        endforeach()
        foreach(metric variance_inflation effective_frames noise_normalized_mse excess_mse)
          string(JSON kind TYPE "${json}" scenes ${s} cases ${c} sequence_ensemble ${metric})
          if(NOT kind STREQUAL "NUMBER" AND NOT kind STREQUAL "NULL")
            message(FATAL_ERROR "Invalid sequence ensemble ${metric}")
          endif()
        endforeach()
      else()
        string(JSON ensemble_type TYPE "${json}" scenes ${s} cases ${c} sequence_ensemble)
        if(NOT convergence STREQUAL "NULL" OR NOT ensemble_type STREQUAL "NULL")
          message(FATAL_ERROR "Moving frames must not be treated as static convergence")
        endif()
      endif()
      # Static replications are sequence means; moving ones are each pose's
      # frame across sequences, with that pose's own reference noise.
      string(JSON bias_kind GET "${json}" scenes ${s} cases ${c} replication_bias replication)
      string(JSON bias_replications GET "${json}" scenes ${s} cases ${c} replication_bias replications)
      string(JSON bias_poses GET "${json}" scenes ${s} cases ${c} replication_bias poses)
      string(JSON bias_regions LENGTH "${json}" scenes ${s} cases ${c} replication_bias regions)
      string(JSON tile_size GET "${json}" scenes ${s} cases ${c} replication_bias tiles size)
      string(JSON tile_tests GET "${json}" scenes ${s} cases ${c} replication_bias tiles tests)
      string(JSON tiles_beyond GET "${json}" scenes ${s} cases ${c} replication_bias tiles beyond_3)
      string(JSON bias_reference GET "${json}" scenes ${s} cases ${c} replication_bias reference_noise_mse)
      if(s EQUAL 0)
        set(expected_kind sequence-mean)
        set(expected_poses 1)
      else()
        set(expected_kind pose-frame)
        set(expected_poses 4)
      endif()
      math(EXPR max_tests "12 * ${expected_poses}")
      if(NOT bias_kind STREQUAL expected_kind OR NOT bias_replications EQUAL 2 OR
         NOT bias_poses EQUAL expected_poses OR NOT bias_regions EQUAL regions OR
         NOT tile_size EQUAL 8 OR tile_tests GREATER max_tests OR tiles_beyond GREATER tile_tests OR
         (s EQUAL 0 AND WORKLOAD STREQUAL "distant" AND NOT bias_reference EQUAL 0) OR
         ((s EQUAL 1 OR NOT WORKLOAD STREQUAL "distant") AND NOT bias_reference GREATER 0))
        message(FATAL_ERROR "Wrong replication bias populations or reference noise")
      endif()
      foreach(metric pose_grand_mean_mse pose_noise_mse pose_reference_noise_mse)
        string(JSON population LENGTH "${json}" scenes ${s} cases ${c} replication_bias ${metric})
        if(NOT population EQUAL expected_poses)
          message(FATAL_ERROR "Wrong replication bias pose population: ${metric}")
        endif()
      endforeach()
      foreach(metric grand_mean_mse noise_mse)
        string(JSON value GET "${json}" scenes ${s} cases ${c} replication_bias ${metric})
        if(value LESS 0)
          message(FATAL_ERROR "Negative replication bias ${metric}")
        endif()
      endforeach()
      if(regions GREATER 0)
        math(EXPR last_region "${regions} - 1")
        foreach(r RANGE 0 ${last_region})
          string(JSON region_id GET "${json}" scenes ${s} cases ${c} regions ${r} id)
          string(JSON bias_region_id GET "${json}" scenes ${s} cases ${c} replication_bias regions ${r} id)
          string(JSON bias_region_pixels GET "${json}" scenes ${s} cases ${c} replication_bias regions ${r} pixels)
          if(NOT bias_region_id STREQUAL region_id OR NOT bias_region_pixels EQUAL 64)
            message(FATAL_ERROR "Replication bias regions differ from ensemble regions")
          endif()
        endforeach()
      endif()
      string(JSON tile_max TYPE "${json}" scenes ${s} cases ${c} replication_bias tiles max)
      if((tile_tests EQUAL 0 AND NOT tile_max STREQUAL "NULL") OR
         (tile_tests GREATER 0 AND NOT tile_max STREQUAL "OBJECT"))
        message(FATAL_ERROR "Largest tile z must exist exactly when a tile test is defined")
      endif()
      foreach(metric fresh_rmse residual_frame_delta_rmse render_update_wall_ms)
        string(JSON population LENGTH "${json}" scenes ${s} cases ${c} ${metric} raw)
        if((metric STREQUAL "residual_frame_delta_rmse" AND NOT population EQUAL 6) OR
           (NOT metric STREQUAL "residual_frame_delta_rmse" AND NOT population EQUAL 8))
          message(FATAL_ERROR "Wrong sample population or sequence-boundary exclusion")
        endif()
      endforeach()
      foreach(metric sequence_mean_rmse centered_rmse)
        string(JSON population LENGTH "${json}" scenes ${s} cases ${c} temporal_residuals ${metric} raw)
        string(JSON rms GET "${json}" scenes ${s} cases ${c} temporal_residuals ${metric} mean)
        if(NOT population EQUAL 2 OR rms LESS 0)
          message(FATAL_ERROR "Wrong temporal residual sequence population")
        endif()
      endforeach()
      string(JSON population LENGTH "${json}" scenes ${s} cases ${c} temporal_residuals lag1_autocorrelation_raw)
      if(NOT population EQUAL 2)
        message(FATAL_ERROR "Wrong temporal correlation sequence population")
      endif()
      foreach(sequence RANGE 0 1)
        string(JSON kind TYPE "${json}" scenes ${s} cases ${c} temporal_residuals lag1_autocorrelation_raw ${sequence})
        string(JSON centered GET "${json}" scenes ${s} cases ${c} temporal_residuals centered_rmse raw ${sequence})
        if(kind STREQUAL "NULL")
          if(NOT centered EQUAL 0)
            message(FATAL_ERROR "Nonconstant residual has undefined correlation")
          endif()
        else()
          string(JSON correlation GET "${json}" scenes ${s} cases ${c} temporal_residuals lag1_autocorrelation_raw ${sequence})
          if(centered EQUAL 0 OR correlation LESS -1.00000001 OR correlation GREATER 1.00000001)
            message(FATAL_ERROR "Invalid temporal correlation")
          endif()
        endif()
      endforeach()
      string(JSON gpu_type TYPE "${json}" scenes ${s} cases ${c} scene_gpu_ms)
      if(NOT gpu_type STREQUAL "NULL")
        string(JSON gpu_population LENGTH "${json}" scenes ${s} cases ${c} scene_gpu_ms raw)
        string(JSON gpu_mean GET "${json}" scenes ${s} cases ${c} scene_gpu_ms mean)
        if(NOT gpu_population EQUAL 8 OR NOT gpu_mean GREATER 0)
          message(FATAL_ERROR "Wrong GPU timestamp population")
        endif()
        foreach(metric initial_gpu_ms temporal_gpu_ms spatial_gpu_ms)
          string(JSON component_type TYPE "${json}" scenes ${s} cases ${c} ${metric})
          if(mode STREQUAL "mis")
            if(NOT component_type STREQUAL "NULL")
              message(FATAL_ERROR "NEE/MIS must not claim reservoir timings")
            endif()
          else()
            string(JSON component_population LENGTH "${json}" scenes ${s} cases ${c} ${metric} raw)
            if(NOT component_population EQUAL 8)
              message(FATAL_ERROR "Wrong reservoir timestamp population")
            endif()
          endif()
        endforeach()
      endif()
    endforeach()
  endforeach()
endif()
if(NO_DRIVER AND (NOT result STREQUAL "77" OR NOT output MATCHES "vkCreateInstance failed with VkResult -9"))
  message(FATAL_ERROR "Missing driver must have explained capability exit 77")
endif()
# Rejected commands preserve an existing report and create no images.
set(sentinel "${TEST_ROOT}/sentinel.json")
file(WRITE "${sentinel}" "preserve")
set(invalid_options
  "--benchmark-size|15" "--benchmark-size|257" "--benchmark-frames|1"
  "--benchmark-frames|257" "--benchmark-warmup|-1" "--restir-sequences|1"
  "--restir-lights|0" "--restir-reference-samples|15" "--restir-reference-samples|4097"
  "--restir-candidates|0" "--restir-candidates|65" "--restir-candidates|1,1"
  "--restir-candidates|1," "--restir-candidates|1junk" "--restir-candidates|"
  "--restir-history-cap|0" "--restir-radius|33" "--benchmark-integrator|unknown"
  "--restir-proposal|unknown" "--restir-proposal|" "--restir-proposal|Power"
  "--restir-workload|unknown" "--restir-workload|" "--restir-workload|Mixed-boundaries"
  "--restir-seed|-1" "--restir-seed|8388608" "--restir-seed|8388607" "--restir-seed|17junk"
  "--restir-reference-seed|16777215" "--restir-reference-seed|1073741824"
  "--restir-reference-seed|-1" "--restir-reference-seed|16777216junk"
  "--restir-bounces|0" "--restir-bounces|65" "--restir-bounces|1junk"
  "--report|renderer-report.json" "--benchmark|other.json")
foreach(pair IN LISTS invalid_options)
  string(REPLACE "|" ";" args "${pair}")
  list(GET args 0 option)
  list(GET args 1 value)
  execute_process(COMMAND "${EXECUTABLE}" --benchmark-restir "${sentinel}" "${option}" "${value}"
    RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
  if(NOT invalid STREQUAL "2")
    message(FATAL_ERROR "Invalid option accepted: ${pair}")
  endif()
endforeach()
foreach(option --restir-lights --restir-bounces --restir-reference-seed)
  execute_process(COMMAND "${EXECUTABLE}" --benchmark-restir "${sentinel}" "${option}"
    RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
  if(NOT invalid STREQUAL "2")
    message(FATAL_ERROR "Missing option value accepted: ${option}")
  endif()
endforeach()
file(READ "${sentinel}" preserved)
if(NOT invalid STREQUAL "2" OR NOT preserved STREQUAL "preserve" OR EXISTS "${TEST_ROOT}/sentinel-images")
  message(FATAL_ERROR "Rejected CLI wrote outputs or accepted a missing value")
endif()
# Output failures must not look like unavailable GPU capability or overwrite a
# prior result. This fails before GPU setup, on every build configuration.
set(blocked "${TEST_ROOT}/blocked.json")
file(WRITE "${blocked}" "preserve")
file(WRITE "${TEST_ROOT}/blocked-images" "not a directory")
execute_process(COMMAND "${EXECUTABLE}" --benchmark-restir "${blocked}"
  RESULT_VARIABLE failed OUTPUT_QUIET ERROR_QUIET)
file(READ "${blocked}" preserved)
if(NOT failed STREQUAL "1" OR NOT preserved STREQUAL "preserve")
  message(FATAL_ERROR "Output failure did not preserve prior report or return failure")
endif()
message(STATUS "ReSTIR benchmark ${INTEGRATOR}: report/measurements/CLI passed; capability exit ${result}")
