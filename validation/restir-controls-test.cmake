cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED EXECUTABLE OR NOT DEFINED TEST_ROOT OR NOT DEFINED INTEGRATOR)
  message(FATAL_ERROR "EXECUTABLE, TEST_ROOT and INTEGRATOR are required")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
foreach(control default reference depth)
  set(options)
  if(control STREQUAL "reference")
    set(options --restir-reference-seed 18874368)
  elseif(control STREQUAL "depth")
    set(options --restir-bounces 4)
  endif()
  execute_process(COMMAND "${EXECUTABLE}" --benchmark-restir "${TEST_ROOT}/${control}.json"
    --benchmark-integrator "${INTEGRATOR}" --restir-workload glossy-spheres
    --benchmark-size 16 --benchmark-frames 2 --benchmark-warmup 0
    --restir-sequences 2 --restir-reference-samples 16 --restir-lights 8
    --restir-candidates 1 ${options}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
  if(NOT result STREQUAL "0" AND NOT result STREQUAL "77")
    message(FATAL_ERROR "Control ${control} failed (${result}): ${output}\n${error}")
  endif()
  file(READ "${TEST_ROOT}/${control}.json" json_${control})
  string(JSON seed GET "${json_${control}}" procedure reference_seed)
  string(JSON bounces GET "${json_${control}}" procedure max_bounces)
  set(expected_seed 16777216)
  set(expected_bounces 1)
  if(control STREQUAL "reference")
    set(expected_seed 18874368)
  elseif(control STREQUAL "depth")
    set(expected_bounces 4)
  endif()
  if(NOT seed EQUAL expected_seed OR NOT bounces EQUAL expected_bounces)
    message(FATAL_ERROR "Wrong control procedure: ${control}")
  endif()
  if(control STREQUAL "default")
    set(capability_result "${result}")
  elseif(NOT result STREQUAL capability_result)
    message(FATAL_ERROR "Controls disagree on GPU availability")
  endif()
endforeach()
if(capability_result STREQUAL "77")
  message(STATUS "Control procedures verified; rendering unavailable (explained SKIP)")
  return()
endif()

set(depth_changed FALSE)
foreach(scene RANGE 0 1)
  string(JSON id GET "${json_default}" scenes ${scene} id)
  foreach(control default reference depth)
    string(JSON directory GET "${json_${control}}" image_directory)
    file(SHA256 "${TEST_ROOT}/${directory}/${id}-mis-reference-0.pfm" hash_${control})
  endforeach()
  if(hash_default STREQUAL hash_reference)
    message(FATAL_ERROR "Reference seed did not change the finite reference")
  endif()
  foreach(case RANGE 0 4)
    foreach(control default reference depth)
      string(JSON directory GET "${json_${control}}" image_directory)
      string(JSON image GET "${json_${control}}" scenes ${scene} cases ${case} ensemble_image)
      file(SHA256 "${TEST_ROOT}/${directory}/${image}" hash_${control})
    endforeach()
    if(NOT hash_default STREQUAL hash_reference)
      message(FATAL_ERROR "Reference seed changed measured radiance")
    endif()
    if(NOT hash_default STREQUAL hash_depth)
      set(depth_changed TRUE)
    endif()
  endforeach()
endforeach()
if(NOT depth_changed)
  message(FATAL_ERROR "Scattering depth did not change measured radiance")
endif()
message(STATUS "Control defaults, reference isolation and scattering-depth effect verified")
