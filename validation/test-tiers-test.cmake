cmake_minimum_required(VERSION 3.24)
# Every registered test carries exactly one tier label
# (docs/design/TEST_POLICY.md), and research tests exist only when
# LOTUS_RESEARCH_TESTS registered them.
if(NOT DEFINED CTEST OR NOT DEFINED BUILD_DIR OR NOT DEFINED RESEARCH)
  message(FATAL_ERROR "CTEST, BUILD_DIR and RESEARCH are required")
endif()
set(config)
if(CONFIG)
  set(config -C "${CONFIG}")
endif()
execute_process(COMMAND "${CTEST}" --show-only=json-v1 ${config}
  WORKING_DIRECTORY "${BUILD_DIR}"
  RESULT_VARIABLE result OUTPUT_VARIABLE json ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "ctest --show-only failed (${result}): ${error}")
endif()
string(JSON count LENGTH "${json}" tests)
if(count EQUAL 0)
  message(FATAL_ERROR "No tests are registered")
endif()
set(problems)
set(research_count 0)
math(EXPR last "${count} - 1")
foreach(t RANGE ${last})
  string(JSON name GET "${json}" tests ${t} name)
  set(tiers)
  string(JSON properties ERROR_VARIABLE missing GET "${json}" tests ${t} properties)
  if(NOT missing)
    string(JSON property_count LENGTH "${properties}")
    if(property_count GREATER 0)
      math(EXPR last_property "${property_count} - 1")
      foreach(p RANGE ${last_property})
        string(JSON property GET "${properties}" ${p} name)
        if(property STREQUAL "LABELS")
          string(JSON labels GET "${properties}" ${p} value)
          string(JSON label_count LENGTH "${labels}")
          math(EXPR last_label "${label_count} - 1")
          foreach(l RANGE ${last_label})
            string(JSON label GET "${labels}" ${l})
            if(label MATCHES "^(fast|gpu|research)$")
              list(APPEND tiers ${label})
            endif()
          endforeach()
        endif()
      endforeach()
    endif()
  endif()
  list(LENGTH tiers tier_count)
  if(NOT tier_count EQUAL 1)
    list(APPEND problems "${name}: tiers '${tiers}'")
  elseif(tiers STREQUAL "research")
    math(EXPR research_count "${research_count} + 1")
  endif()
endforeach()
if(problems)
  list(JOIN problems "\n  " text)
  message(FATAL_ERROR "Tests need exactly one of fast, gpu or research:\n  ${text}")
endif()
if(NOT RESEARCH AND research_count GREATER 0)
  message(FATAL_ERROR "Research tests are registered without LOTUS_RESEARCH_TESTS")
endif()
if(RESEARCH AND research_count EQUAL 0)
  message(FATAL_ERROR "LOTUS_RESEARCH_TESTS registered no research tests")
endif()
message(STATUS "Test tiers: ${count} tests, ${research_count} research")
