# Checks that each asset validation/assets/manifest.json lists is present,
# of its recorded size and SHA-256, beside its licence file.
# Usage: cmake -DASSETS=<directory> -P assets-test.cmake
if(NOT DEFINED ASSETS)
  message(FATAL_ERROR "ASSETS is not set")
endif()
file(READ "${ASSETS}/manifest.json" manifest)
string(JSON count LENGTH "${manifest}" assets)
if(count EQUAL 0)
  message(FATAL_ERROR "the manifest lists no assets")
endif()
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  string(JSON path GET "${manifest}" assets ${index} path)
  string(JSON bytes GET "${manifest}" assets ${index} bytes)
  string(JSON sha256 GET "${manifest}" assets ${index} sha256)
  string(JSON license GET "${manifest}" assets ${index} license file)
  if(NOT EXISTS "${ASSETS}/${path}")
    message(FATAL_ERROR "${path} is missing")
  endif()
  if(NOT EXISTS "${ASSETS}/${license}")
    message(FATAL_ERROR "${path}'s licence file ${license} is missing")
  endif()
  file(SIZE "${ASSETS}/${path}" size)
  if(NOT size EQUAL bytes)
    message(FATAL_ERROR "${path} has ${size} bytes, the manifest ${bytes}")
  endif()
  file(SHA256 "${ASSETS}/${path}" actual)
  if(NOT actual STREQUAL sha256)
    message(FATAL_ERROR "${path} has SHA-256 ${actual}, the manifest ${sha256}")
  endif()
  message(STATUS "${path}: ${size} bytes, SHA-256 ${actual}")
endforeach()
