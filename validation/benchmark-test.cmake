# Validate the benchmark consumer contract, including capability SKIPs and
# rejected CLI arguments. No timing threshold is used as a correctness gate.
# INTEGRATOR selects --benchmark-integrator; reference by default.
# LIGHT_SAMPLING selects --benchmark-light-sampling; bsdf by default.
if(NOT DEFINED EXECUTABLE OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "EXECUTABLE and TEST_ROOT are required")
endif()
if(NOT DEFINED INTEGRATOR)
  set(INTEGRATOR reference)
endif()
if(NOT DEFINED LIGHT_SAMPLING)
  set(LIGHT_SAMPLING bsdf)
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
if(NO_DRIVER)
  set(manifest "${TEST_ROOT}/unavailable-manifest.json")
  if(EXISTS "${manifest}")
    message(FATAL_ERROR "Missing-driver manifest must not exist")
  endif()
  set(ENV{VK_DRIVER_FILES} "${manifest}")
  set(ENV{VK_ICD_FILENAMES} "${manifest}")
endif()
set(report "${TEST_ROOT}/benchmark.json")
execute_process(COMMAND "${EXECUTABLE}" --benchmark "${report}"
  --benchmark-frames 16 --benchmark-warmup 2
  --benchmark-label "CTest quoted \"label\""
  --benchmark-integrator "${INTEGRATOR}"
  --benchmark-light-sampling "${LIGHT_SAMPLING}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
if(NOT result STREQUAL "0" AND NOT result STREQUAL "77")
  message(FATAL_ERROR "Benchmark failed (${result}):\n${output}\n${error}")
endif()
file(READ "${report}" json)
string(JSON schema GET "${json}" schema)
string(JSON count LENGTH "${json}" scenes)
string(JSON frames GET "${json}" procedure measured_frames)
string(JSON warmup GET "${json}" procedure warmup_frames)
string(JSON label GET "${json}" build label)
string(JSON integrator GET "${json}" procedure integrator)
string(JSON light_sampling GET "${json}" procedure light_sampling)
string(JSON width GET "${json}" procedure width)
string(JSON compared GET "${json}" procedure cornell_reference_compared)
if(NOT schema STREQUAL "lotus-benchmark-v1" OR NOT count EQUAL 6 OR
   NOT frames EQUAL 16 OR NOT warmup EQUAL 2 OR
   NOT label STREQUAL "CTest quoted \"label\"" OR
   NOT integrator STREQUAL INTEGRATOR OR
   NOT light_sampling STREQUAL LIGHT_SAMPLING OR NOT width EQUAL 128 OR
   NOT compared STREQUAL "ON")
  message(FATAL_ERROR "Wrong benchmark schema, workload count or procedure")
endif()
# The wavefront integrator counts its rays; the reference shader does not.
set(unavailable total_vram_bytes cpu_render_submit_ms)
if(INTEGRATOR STREQUAL "reference")
  list(APPEND unavailable rays_per_second average_path_depth)
else()
  foreach(metric rays_per_second average_path_depth)
    string(JSON type ERROR_VARIABLE missing TYPE "${json}" unavailable "${metric}")
    if(NOT missing)
      message(FATAL_ERROR "The wavefront benchmark reports ${metric} as unavailable")
    endif()
  endforeach()
endif()
foreach(metric ${unavailable})
  string(JSON type TYPE "${json}" unavailable "${metric}")
  string(JSON reason GET "${json}" unavailable_reasons "${metric}")
  if(NOT type STREQUAL "NULL" OR reason STREQUAL "")
    message(FATAL_ERROR "Unavailable ${metric} must be null and explained")
  endif()
endforeach()
set(ids cornell-v1 textured-v1 instanced-v1 geometry-v1 lights-v1 environment-v1)
set(triangles 36 32768 2 524288 32 26)
set(instances 8 16 4096 1 6 3)
set(textures 0 16 0 0 0 1)
# The light table: emissive triangles, analytic lights, a sampled image.
set(emissive 2 0 0 0 0 0)
set(analytic 0 0 0 0 4 0)
set(sampled OFF OFF OFF OFF OFF ON)
foreach(i RANGE 0 5)
  list(GET ids ${i} expected_id)
  string(JSON id GET "${json}" scenes ${i} id)
  string(JSON status GET "${json}" scenes ${i} status)
  if(NOT id STREQUAL expected_id)
    message(FATAL_ERROR "Unexpected scene identity ${id}")
  endif()
  if(result STREQUAL "77")
    string(JSON why GET "${json}" scenes ${i} detail)
    string(JSON type TYPE "${json}" scenes ${i} measurements)
    if(NOT status STREQUAL "skip" OR why STREQUAL "" OR NOT type STREQUAL "NULL")
      message(FATAL_ERROR "Unavailable scene must have explained SKIP without measurements")
    endif()
  else()
    if(NOT status STREQUAL "pass")
      message(FATAL_ERROR "Successful benchmark contains ${status} scene")
    endif()
    list(GET triangles ${i} expected_triangles)
    list(GET instances ${i} expected_instances)
    list(GET textures ${i} expected_textures)
    list(GET emissive ${i} expected_emissive)
    list(GET analytic ${i} expected_analytic)
    list(GET sampled ${i} expected_sampled)
    string(JSON actual_emissive GET "${json}" scenes ${i} measurements scene emissive_triangles)
    string(JSON actual_analytic GET "${json}" scenes ${i} measurements scene analytic_lights)
    string(JSON actual_sampled GET "${json}" scenes ${i} measurements scene environment_sampled)
    string(JSON variance GET "${json}" scenes ${i} measurements per_sample_variance)
    string(JSON variance_time TYPE "${json}" scenes ${i} measurements variance_gpu_ms)
    if(NOT actual_emissive EQUAL expected_emissive OR
       NOT actual_analytic EQUAL expected_analytic OR
       NOT actual_sampled STREQUAL expected_sampled OR NOT variance GREATER 0 OR
       NOT variance_time MATCHES "^(NUMBER|NULL)$")
      message(FATAL_ERROR "Wrong light table or per-sample variance for ${id}")
    endif()
    string(JSON actual_triangles GET "${json}" scenes ${i} measurements scene unique_triangles)
    string(JSON actual_instances GET "${json}" scenes ${i} measurements scene instances)
    string(JSON actual_textures GET "${json}" scenes ${i} measurements scene textures)
    string(JSON samples LENGTH "${json}" scenes ${i} measurements render_wall_ms raw)
    string(JSON unchanged LENGTH "${json}" scenes ${i} measurements unchanged_cpu_ms raw)
    string(JSON image GET "${json}" scenes ${i} measurements image)
    string(JSON messages GET "${json}" scenes ${i} measurements validation messages)
    string(JSON wavefront TYPE "${json}" scenes ${i} measurements wavefront)
    if(INTEGRATOR STREQUAL "reference")
      if(NOT wavefront STREQUAL "NULL")
        message(FATAL_ERROR "The reference benchmark has wavefront measurements for ${id}")
      endif()
    else()
      string(JSON rays LENGTH "${json}" scenes ${i} measurements wavefront rays raw)
      string(JSON rays_per_path GET "${json}" scenes ${i} measurements wavefront rays_per_path)
      string(JSON rounds LENGTH "${json}" scenes ${i} measurements wavefront rounds raw)
      string(JSON first_round GET "${json}" scenes ${i} measurements wavefront rounds min)
      if(NOT rays EQUAL 16 OR rays_per_path LESS 1 OR NOT rounds EQUAL 16 OR
         first_round LESS 1)
        message(FATAL_ERROR "Wrong wavefront ray counts for ${id}")
      endif()
    endif()
    if(NOT actual_triangles EQUAL expected_triangles OR
       NOT actual_instances EQUAL expected_instances OR
       NOT actual_textures EQUAL expected_textures OR NOT samples EQUAL 16 OR
       NOT unchanged EQUAL 16 OR NOT messages EQUAL 0 OR NOT EXISTS "${TEST_ROOT}/${image}")
      message(FATAL_ERROR "Wrong workload counts, sample population, validation or image for ${id}")
    endif()
  endif()
endforeach()
if(NO_DRIVER AND (NOT result STREQUAL "77" OR
   NOT output MATCHES "vkCreateInstance failed with VkResult -9"))
  message(FATAL_ERROR "Missing driver must have explained SKIP (77): ${output}")
endif()
# Invalid numbers/mixed correctness options must fail before touching outputs.
file(WRITE "${TEST_ROOT}/sentinel.json" "preserve")
foreach(value 0 -1 4097 1junk)
  execute_process(COMMAND "${EXECUTABLE}" --benchmark "${TEST_ROOT}/sentinel.json"
    --benchmark-frames "${value}" RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
  if(NOT invalid STREQUAL "2")
    message(FATAL_ERROR "Invalid frame count ${value} was accepted")
  endif()
endforeach()
foreach(value 15 4097 1junk)
  execute_process(COMMAND "${EXECUTABLE}" --benchmark "${TEST_ROOT}/sentinel.json"
    --benchmark-size "${value}" RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
  if(NOT invalid STREQUAL "2")
    message(FATAL_ERROR "Invalid target size ${value} was accepted")
  endif()
endforeach()
execute_process(COMMAND "${EXECUTABLE}" --benchmark "${TEST_ROOT}/sentinel.json"
  --benchmark-integrator megakernel RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
if(NOT invalid STREQUAL "2")
  message(FATAL_ERROR "An unknown integrator was accepted")
endif()
execute_process(COMMAND "${EXECUTABLE}" --benchmark "${TEST_ROOT}/sentinel.json"
  --benchmark-light-sampling nee RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
if(NOT invalid STREQUAL "2")
  message(FATAL_ERROR "An unknown light sampling was accepted")
endif()
execute_process(COMMAND "${EXECUTABLE}" --benchmark "${TEST_ROOT}/sentinel.json"
  --report "${TEST_ROOT}/renderer-report.json" RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
file(READ "${TEST_ROOT}/sentinel.json" sentinel)
if(NOT invalid STREQUAL "2" OR NOT sentinel STREQUAL "preserve" OR
   EXISTS "${TEST_ROOT}/renderer-report.json")
  message(FATAL_ERROR "Benchmark accepted correctness options or overwrote rejected output")
endif()
message(STATUS "Benchmark schema/workloads/CLI passed for the ${INTEGRATOR} integrator with ${LIGHT_SAMPLING} light sampling; capability exit ${result}")

# One small many-light case protects selection and the shared fixture; do
# not multiply it across all integrators and legacy benchmark modes.
if(LIGHT_SAMPLING STREQUAL "mis")
  execute_process(COMMAND "${EXECUTABLE}" --benchmark "${TEST_ROOT}/selected.json"
    --benchmark-workload many-lights-v1 --benchmark-light-sampling mis
    --benchmark-frames 4 --benchmark-warmup 2 --benchmark-size 32
    RESULT_VARIABLE selected OUTPUT_VARIABLE selected_output ERROR_VARIABLE selected_error TIMEOUT 120)
  if(NOT selected STREQUAL "0" AND NOT selected STREQUAL "77")
    message(FATAL_ERROR "Selected workload failed: ${selected_output} ${selected_error}")
  endif()
  file(READ "${TEST_ROOT}/selected.json" selected_json)
  string(JSON count LENGTH "${selected_json}" scenes)
  string(JSON id GET "${selected_json}" scenes 0 id)
  string(JSON compared GET "${selected_json}" procedure cornell_reference_compared)
  if(NOT count EQUAL 1 OR NOT id STREQUAL "many-lights-v1" OR compared)
    message(FATAL_ERROR "Selection did not isolate the many-light fixture")
  endif()
  if(selected STREQUAL "0")
    string(JSON lights GET "${selected_json}" scenes 0 measurements scene analytic_lights)
    if(NOT lights EQUAL 256)
      message(FATAL_ERROR "Many-light workload must contain 256 analytic lights")
    endif()
  endif()
endif()
execute_process(COMMAND "${EXECUTABLE}" --benchmark "${TEST_ROOT}/sentinel.json"
  --benchmark-workload typo RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
file(READ "${TEST_ROOT}/sentinel.json" sentinel)
if(NOT invalid STREQUAL "2" OR NOT sentinel STREQUAL "preserve")
  message(FATAL_ERROR "Unknown workload was accepted or changed the output")
endif()
