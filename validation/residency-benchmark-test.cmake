cmake_minimum_required(VERSION 3.24)
# The residency report's procedure and inventory at a small, non-square
# size: each mode's owners and per-pixel lower bounds. Sizes beyond those
# bounds (alignment, driver choices) are observed, never a pass threshold.
if(NOT DEFINED EXECUTABLE OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "EXECUTABLE and TEST_ROOT are required")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
if(NO_DRIVER)
  set(manifest "${TEST_ROOT}/unavailable-manifest.json")
  if(EXISTS "${manifest}")
    message(FATAL_ERROR "Missing-driver manifest must not exist")
  endif()
  set(ENV{VK_DRIVER_FILES} "${manifest}")
  set(ENV{VK_ICD_FILENAMES} "${manifest}")
endif()
foreach(rejected "--residency-width;8" "--residency-frames;0" "--residency-mode;unknown"
    "--residency-workload;unknown" "--residency-unknown;1")
  execute_process(COMMAND "${EXECUTABLE}" --benchmark-residency "${TEST_ROOT}/rejected.json" ${rejected}
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 60)
  if(NOT result STREQUAL "2" OR EXISTS "${TEST_ROOT}/rejected.json")
    message(FATAL_ERROR "Invalid option ${rejected} was accepted (${result})")
  endif()
endforeach()
set(report "${TEST_ROOT}/residency.json")
set(width 40)
set(height 24)
math(EXPR pixels "${width} * ${height}")
execute_process(COMMAND "${EXECUTABLE}" --benchmark-residency "${report}"
  --benchmark-label "CTest quoted \"label\"" --residency-width ${width} --residency-height ${height}
  --residency-frames 2
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 300)
if(NOT result STREQUAL "0" AND NOT result STREQUAL "77")
  message(FATAL_ERROR "Residency benchmark failed (${result}):\n${output}\n${error}")
endif()
file(READ "${report}" json)
string(JSON schema GET "${json}" schema)
string(JSON status GET "${json}" status)
string(JSON label GET "${json}" build label)
string(JSON reported_pixels GET "${json}" procedure pixels)
string(JSON count LENGTH "${json}" modes)
if(NOT schema STREQUAL "lotus-residency-benchmark-v1" OR NOT label STREQUAL "CTest quoted \"label\"" OR
   NOT reported_pixels EQUAL pixels)
  message(FATAL_ERROR "Wrong schema, build or procedure")
endif()
if(result STREQUAL "77")
  string(JSON first_status GET "${json}" modes 0 status)
  if(NOT status STREQUAL "skip" OR NOT count EQUAL 1 OR NOT first_status STREQUAL "skip")
    message(FATAL_ERROR "Unavailable capabilities must have one explained SKIP")
  endif()
  message(STATUS "SKIP: ${output}")
  return()
endif()
if(NO_DRIVER)
  message(FATAL_ERROR "A missing driver must report SKIP")
endif()
set(ids progressive-reference progressive-wavefront temporal-metadata temporal-radiance svgf
  restir-reuse svgf-restir)
if(NOT status STREQUAL "pass" OR NOT count EQUAL 7)
  message(FATAL_ERROR "Successful report requires all seven modes")
endif()

# Sets <prefix>_allocations and <prefix>_bytes to the last frame's group of
# `owner`, or 0 when the mode has none.
function(group_of mode owner prefix)
  set(allocations 0)
  set(bytes 0)
  string(JSON groups LENGTH "${json}" modes ${mode} measurements last_frame groups)
  math(EXPR last "${groups} - 1")
  foreach(g RANGE 0 ${last})
    string(JSON name GET "${json}" modes ${mode} measurements last_frame groups ${g} owner)
    if(name STREQUAL owner)
      string(JSON allocations GET "${json}" modes ${mode} measurements last_frame groups ${g} allocations)
      string(JSON bytes GET "${json}" modes ${mode} measurements last_frame groups ${g} bytes)
    endif()
  endforeach()
  set(${prefix}_allocations ${allocations} PARENT_SCOPE)
  set(${prefix}_bytes ${bytes} PARENT_SCOPE)
endfunction()

# Requires the group of `owner` in `mode` to have `allocations` allocations
# of at least `per_pixel` bytes per pixel; 0 allocations require its absence.
function(require_group mode owner allocations per_pixel)
  group_of(${mode} ${owner} group)
  math(EXPR minimum "${per_pixel} * ${pixels}")
  if(NOT group_allocations EQUAL allocations OR group_bytes LESS minimum)
    list(GET ids ${mode} id)
    message(FATAL_ERROR "${id}: ${owner} has ${group_allocations} allocations of ${group_bytes} bytes; "
      "expected ${allocations} of at least ${minimum}")
  endif()
endfunction()

foreach(m RANGE 0 6)
  list(GET ids ${m} expected_id)
  string(JSON id GET "${json}" modes ${m} id)
  string(JSON mode_status GET "${json}" modes ${m} status)
  if(NOT id STREQUAL expected_id OR NOT mode_status STREQUAL "pass")
    message(FATAL_ERROR "Wrong or failed mode ${m}: ${id} ${mode_status}")
  endif()
  # The groups sum to the totals in every sample.
  foreach(sample created uploaded last_frame)
    string(JSON device GET "${json}" modes ${m} measurements ${sample} device_local_bytes)
    string(JSON host GET "${json}" modes ${m} measurements ${sample} host_bytes)
    string(JSON groups LENGTH "${json}" modes ${m} measurements ${sample} groups)
    set(sum 0)
    if(groups GREATER 0)
      math(EXPR last "${groups} - 1")
      foreach(g RANGE 0 ${last})
        string(JSON bytes GET "${json}" modes ${m} measurements ${sample} groups ${g} bytes)
        math(EXPR sum "${sum} + ${bytes}")
      endforeach()
    endif()
    math(EXPR total "${device} + ${host}")
    if(NOT sum EQUAL total)
      message(FATAL_ERROR "${id} ${sample}: groups sum to ${sum}, totals to ${total}")
    endif()
  endforeach()
  string(JSON budget GET "${json}" modes ${m} measurements budget_available)
  if(budget)
    string(JSON usage GET "${json}" modes ${m} measurements last_frame heaps 0 process_usage)
    string(JSON peak GET "${json}" modes ${m} measurements sampled_peak heap_process_usage 0)
    if(usage LESS 0 OR peak LESS usage)
      message(FATAL_ERROR "${id}: heap usage ${usage} exceeds its sampled peak ${peak}")
    endif()
  endif()
  group_of(${m} scene.pools pools)
  if(pools_allocations EQUAL 0)
    message(FATAL_ERROR "${id}: the uploaded scene has no pool blocks")
  endif()
  # The scene targets: accumulation, colour and depth images, and the
  # colour/depth mirrors, at least 36 and 20 bytes per pixel.
  require_group(${m} targets.scene 3 36)
  require_group(${m} targets.scene.readback 2 20)
endforeach()

# Index: 0 progressive-reference, 1 progressive-wavefront, 2 temporal-metadata,
# 3 temporal-radiance, 4 svgf, 5 restir-reuse, 6 svgf-restir.
require_group(0 temporal.surfaces 0 0)
require_group(0 wavefront.state 0 0)
# Queue counters, three queues of 4 bytes per path and five 16-byte path
# sections.
require_group(1 wavefront.state 3 92)
foreach(m RANGE 2 6)
  require_group(${m} temporal.surfaces 2 128)
  require_group(${m} temporal.surfaces.readback 1 128)
  require_group(${m} temporal.validity 1 16)
  require_group(${m} temporal.validity.readback 1 16)
endforeach()
foreach(m 2 5)
  require_group(${m} temporal.radiance 0 0)
endforeach()
foreach(m 3 4 6)
  # Two 32-byte histories and the 16-byte fresh batch, and their mirror.
  require_group(${m} temporal.radiance 3 80)
  require_group(${m} temporal.radiance.readback 1 80)
endforeach()
require_group(3 temporal.filter 0 0)
require_group(4 temporal.filter 1 48)
require_group(6 temporal.filter 1 48)
foreach(m 5 6)
  require_group(${m} restir.initial 1 48)
  require_group(${m} restir.initial.readback 1 48)
  require_group(${m} restir.history 2 384)
  require_group(${m} restir.history.readback 1 384)
  require_group(${m} restir.spatial 2 208)
  require_group(${m} restir.spatial.readback 2 208)
endforeach()
require_group(4 restir.history 0 0)
