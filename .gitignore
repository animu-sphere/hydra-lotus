# OpenStrata and out-of-source build products.
/.strata/
/build/
/cmake-build-*/
/dist/
/install/
/lib/
/out/
/CMakeUserPresets.json
/compile_commands.json
# `ost` pins each profile's runtime in its own lock (`strata.lock` for the
# default, `strata.<runtime-id>.lock` for the rest); they record this
# workstation, not the project.
/strata.lock
/strata.*.lock

# Accidental in-source CMake and Ninja products.
/CMakeCache.txt
/CMakeFiles/
/CTestTestfile.cmake
/Testing/
/build.ninja
/cmake_install.cmake
/install_manifest.txt
/Makefile
/.ninja_deps
/.ninja_log

# Python tooling and test caches.
__pycache__/
*.py[cod]
.pytest_cache/

# Local editor, compiler-index, and OS metadata.
/.vs/
/.idea/
/.cache/clangd/
*.suo
*.user
*.VC.db
*.VC.VC.opendb
.DS_Store
Thumbs.db

# Generated renderer evidence.
renderer-report.json
renderer-*-report.json
CMakeUserPresets.json
